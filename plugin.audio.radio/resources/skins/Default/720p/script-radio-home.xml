    <!-- (v1.2.13) Barre de lecture, ligne et egaliseur retires :
         pendant l'ecoute, la vue logo plein ecran de la station
         remplace la barre (retour au menu = lecture qui continue,
         arret par la touche Stop de Kodi). -->
  </controls>
</window>
