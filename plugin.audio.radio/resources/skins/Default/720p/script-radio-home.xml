          <aspectratio>keep</aspectratio>
          <visible>!Control.HasFocus(220)</visible>
        </control>
        <control type="image">
          <left>6</left><top>-2</top><width>141</width><height>141</height>
          <texture background="true" colordiffuse="FFFFFFFF">$INFO[ListItem.Art(thumb)]</texture>
          <aspectratio>keep</aspectratio>
          <visible>Control.HasFocus(220)</visible>
        </control>
        <control type="label">
          <left>2</left><top>146</top><width>149</width><height>20</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font12</font><textcolor>FF7A828E</textcolor><align>center</align>
